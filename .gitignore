# Deny by default.
# Nothing is tracked unless explicitly unblocked below. Build output (build/,
# out/, bin/), tool state (.gradle/, .idea/, .kotlin/, .pitest-history/),
# local config (.config/, .configs/, .local/), scratch checkouts (glam/,
# idl-clients/, symlinks/), Jazzer crash reproducers and JVM dumps all fall
# through this rule with no further mention.
#
# To track a new directory you must unblock the directory itself *and* its
# contents, e.g. `!/mod/src/` followed by `!/mod/src/**` -- git will not
# descend into an ignored directory to find re-included files.
*

### Root files ###
!/.gitignore
!/.release-please-manifest.json
!/AGENTS.md
!/CHANGELOG.md
!/LICENSE
!/README.md
!/downloadMappings.sh
!/gradle.properties
!/gradlew
!/gradlew.bat
!/main_net_programs.json
!/release-please-config.json
!/settings.gradle.kts
!/syncMappings.sh

# Both reports idl-src-gen emits from one run: the movement events this run saw, and the
# standing gap dashboard beside it. The gap file needs its own rule -- it is named by the
# generator rather than by the --report flag, so nothing here would have re-included it and
# the deny-by-default rule above would swallow a committed deliverable silently. It did:
# 92318b2's report was lost exactly that way (the earlier record commits predate the
# generator writing a report by default and had none to lose).
!/idl-change-report.txt
!/idl-change-report-gap.txt

### CI ###
!/.github/
!/.github/**

### Runtime config ###
!/conf/
!/conf/**

### Gradle ###
!/gradle/
!/gradle/*.properties
!/gradle/aggregation/
!/gradle/aggregation/build.gradle.kts
!/gradle/wrapper/
!/gradle/wrapper/gradle-wrapper.jar
!/gradle/wrapper/gradle-wrapper.properties

### examples ###
!/examples/
!/examples/build.gradle.kts
!/examples/src/
!/examples/src/**

### sdk ###
!/sdk/
!/sdk/build.gradle.kts
!/sdk/config/
!/sdk/config/**
!/sdk/src/
!/sdk/src/**

### services ###
!/services/
!/services/build.gradle.kts
!/services/config/
!/services/config/**
!/services/src/
!/services/src/**

### Re-blocked inside the unblocked trees above (last match wins) ###
# Local integration scratch classes
Integ.*
# macOS Finder metadata
.DS_Store
# Jazzer reproducers and JVM crash/heap dumps, wherever they land
crash-*
Crash_*.java
*.hprof
hs_err_pid*.log
